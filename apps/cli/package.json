{
  "name": "octopus-diff",
  "version": "0.0.0",
  "private": true,
  "description": "octopus-diff command-line interface.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@octopus-diff/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "pack:tarball": "node scripts/pack.mjs"
  },
  "bin": {
    "octopus-diff": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@octopus-diff/contracts": "workspace:*",
    "@octopus-diff/daemon": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@octopus-diff/web": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
