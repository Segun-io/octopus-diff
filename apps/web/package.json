{
  "name": "@octopus-diff/web",
  "version": "0.0.0",
  "private": true,
  "description": "octopus-diff browser UI.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "dev:mock": "tsx --conditions=@octopus-diff/source mock/dev.ts",
    "mock": "tsx --conditions=@octopus-diff/source mock/server.ts",
    "dev:mock:large": "MOCK_DATASET=large tsx --conditions=@octopus-diff/source mock/dev.ts",
    "preview:mock": "tsx --conditions=@octopus-diff/source mock/preview.ts",
    "check:browser": "tsx scripts/browser-check.ts",
    "perf": "tsx --conditions=@octopus-diff/source scripts/perf.ts",
    "perf:smoke": "PERF_SMOKE=1 tsx --conditions=@octopus-diff/source scripts/perf.ts",
    "icons": "tsx scripts/icons.ts",
    "shots": "tsx scripts/shots.ts"
  },
  "dependencies": {
    "@octopus-diff/contracts": "workspace:*",
    "@pierre/diffs": "^1.6.4",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "diff": "^9.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
