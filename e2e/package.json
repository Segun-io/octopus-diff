{
  "name": "@octopus-diff/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for octopus-diff (MVP acceptance list, PLAN \u00a78).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "echo 'e2e: nothing to build'",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "bench": "tsx bench/bench.ts",
    "profile:real": "tsx --conditions=@octopus-diff/source bench/real-repos.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@octopus-diff/contracts": "workspace:*",
    "@octopus-diff/daemon": "workspace:*",
    "@octopus-diff/fixtures": "workspace:*",
    "@octopus-diff/git-core": "workspace:*",
    "@playwright/test": "^1.65.0"
  }
}
